[Unit]
Description=ZSHIELD local privacy dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/zshield
EnvironmentFile=-/etc/zshield/zshield.env
ExecStart=/usr/bin/python3 /opt/zshield/app.py
Restart=on-failure
RestartSec=3
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
